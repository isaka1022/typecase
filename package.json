{
  "name": "typecase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A typesetting studio that teaches by doing — the page declares what it can do, an agent demonstrates it on your live layout, then hands you the controls.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --config vite.probe.config.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:probe": "vite build --config vite.probe.config.ts"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^5.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@mcp-b/webmcp-types": "^5.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  }
}
